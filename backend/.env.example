# Backend service environment.
#
# docker-compose.yml loads this file into the `backend` and `celery-worker`
# containers via `env_file`, so it must exist before `docker compose up`:
#
#     cp backend/.env.example backend/.env
#
# Hostnames below are docker-compose service names. If you run the backend
# directly on your host instead, replace them with localhost and use the
# published ports (postgres 5432, redis 6379, chromadb 8001, minio 9000).

# Application
APP_NAME=GradeAI
# development | production | test
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://gradeai:gradeai@postgres:5432/gradeai
# Sync URL is used by the Celery worker and Alembic.
DATABASE_URL_SYNC=postgresql://gradeai:gradeai@postgres:5432/gradeai

# Redis (cache + refresh-token allowlist + access-token blacklist)
REDIS_URL=redis://redis:6379/0

# ChromaDB (RAG vector store). Port 8000 is correct in-network; the host
# publishes it on 8001.
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# JWT / Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Shared secret required to self-register as a professor/TA/admin. Leave blank
# in development to keep signup frictionless. REQUIRED in production - the app
# refuses to boot without it, because otherwise anyone could register as a
# professor and grade real submissions.
PROFESSOR_REGISTRATION_CODE=

# Abuse protection (fixed window, per client IP)
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_PRESIGN_PER_MINUTE=30

# AI provider (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Hard ceiling on a single Gemini call, in seconds. Prevents a stalled request
# from occupying a Celery worker slot indefinitely.
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# Object storage (S3 or S3-compatible, e.g. MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=gradeai-uploads
# Internal endpoint the backend uses to reach storage.
AWS_S3_ENDPOINT=http://minio:9000
AWS_ENDPOINT_URL=http://minio:9000
# Public endpoint baked into presigned URLs so the browser can reach storage
# directly. Must be reachable from the user's machine, not just the container.
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000

# Uploads: hard cap in bytes (default 25 MiB), enforced against the actual
# stored object at confirm/submit time.
MAX_UPLOAD_SIZE_BYTES=26214400

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Task time limits in seconds. The soft limit raises inside the task so it
# follows the normal retry path; the hard limit kills anything that ignores it.
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660
