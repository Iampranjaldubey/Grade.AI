# Application
APP_NAME=GradeAI
APP_ENV=development
# Allowed: development | production | test
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://gradeai:gradeai@postgres:5432/gradeai
DATABASE_URL_SYNC=postgresql://gradeai:gradeai@postgres:5432/gradeai

# Redis
REDIS_URL=redis://redis:6379/0

# ChromaDB
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# JWT / Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Shared secret required to self-register as a professor/TA/admin. Leave blank
# in development. REQUIRED in production - the app refuses to boot without it,
# because otherwise anyone could register as a professor and grade submissions.
PROFESSOR_REGISTRATION_CODE=

# Abuse protection (fixed window, per client IP)
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_PRESIGN_PER_MINUTE=30

# AI Providers (Google Gemini is the active provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Hard ceiling on a single Gemini call, in seconds.
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# AWS S3 (or S3-compatible storage such as MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=gradeai-uploads
# Internal endpoint the backend uses to reach storage (e.g. http://minio:9000).
AWS_S3_ENDPOINT=
# Alternate name some SDK paths read for the internal endpoint. Leave blank to
# fall back to AWS_S3_ENDPOINT / real AWS.
AWS_ENDPOINT_URL=
# Public endpoint returned in presigned URLs so browsers can reach storage
# directly (e.g. http://localhost:9000). Defaults to the internal endpoint.
AWS_S3_PUBLIC_ENDPOINT=

# Uploads
# Hard cap on uploaded file size in bytes (default 25 MiB). Enforced against the
# actual stored object size at confirm/submit time.
MAX_UPLOAD_SIZE_BYTES=26214400

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Task time limits in seconds. The soft limit raises inside the task so it
# follows the normal retry path; the hard limit kills anything that ignores it.
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660

# Frontend (build-time / Vite)
VITE_API_BASE_URL=http://localhost/api/v1

# Nginx
NGINX_PORT=80

# Postgres (docker-compose)
POSTGRES_USER=gradeai
POSTGRES_PASSWORD=gradeai
POSTGRES_DB=gradeai
